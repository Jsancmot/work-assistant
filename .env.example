# ── Mandatory ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...

# ── Notion MCP ────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...

# ── Google MCP ────────────────────────────────────────────────────────────────
# Path to the Google OAuth 2.0 credentials JSON file downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Optional overrides ────────────────────────────────────────────────────────
# OPENAI_MODEL=gpt-4o
# AGENT_NAME=Work Assistant
