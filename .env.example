# ── Mandatory ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...

# ── Notion MCP ────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...

# ── Google MCP ────────────────────────────────────────────────────────────────
# Path to the Google OAuth 2.0 credentials JSON file downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Optional overrides ────────────────────────────────────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# AGENT_NAME=Work Assistant
