# ── Mandatory ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
# Comma-separated user IDs allowed to use the bot (e.g., "123456789,987654321")
TELEGRAM_ALLOWED_USERS=

# ── Notion MCP ────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...

# ── Google Calendar MCP ────────────────────────────────────────────────────────
# Path to OAuth credentials JSON file from Google Cloud Console (Desktop app type)
GOOGLE_OAUTH_CREDENTIALS=gcp-oauth.keys.json

# ── Optional overrides ────────────────────────────────────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# AGENT_NAME=Work Assistant
# Language for agent responses (e.g., English, Spanish, French)
AGENT_LANGUAGE=English
